 0.0, "avg_logprob": -0.13247234637920674, "compression_ratio": 1.6481481481481481, "no_speech_prob": 0.010545991361141205}, {"id": 22, "seek": 8074, "start": 102.46, "end": 107.82, "text": " En la planta principal, los ventanales representan bocas abiertas gritando de terror y sobre", "tokens": [51450, 2193, 635, 3709, 64, 9716, 11, 1750, 6931, 282, 4229, 2906, 282, 748, 16369, 410, 4859, 296, 30133, 1806, 368, 8127, 288, 5473, 51718], "temperature": 0.0, "avg_logprob": -0.13247234637920674, "compression_ratio": 1.6481481481481481, "no_speech_prob": 0.010545991361141205}, {"id": 23, "seek": 10782, "start": 107.89999999999999, "end": 111.53999999999999, "text": " ellas un murci\u00e9lago con sus alas desplegadas.", "tokens": [50368, 38397, 517, 5257, 537, 8025, 6442, 416, 3291, 419, 296, 730, 781, 70, 6872, 13, 50550], "temperature": 0.0, "avg_logprob": -0.11767493786455012, "compression_ratio": 1.7374100719424461, "no_speech_prob": 0.005187803879380226}, {"id": 24, "seek": 10782, "start": 111.53999999999999, "end": 116.38, "text": " Los balcones de las plantas superiores se asemejan a las calaveras de las v\u00edctimas del drag\u00f3n.", "tokens": [50550, 7632, 26450, 279, 368, 2439, 3709, 296, 1687, 72, 2706, 369, 382, 5729, 14763, 257, 2439, 2104, 20655, 296, 368, 2439, 6153, 349, 17957, 1103, 5286, 1801, 13, 50792], "temperature": 0.0, "avg_logprob": -0.11767493786455012, "compression_ratio": 1.7374100719424461, "no_speech_prob": 0.005187803879380226}, {"id": 25, "seek": 10782, "start": 116.38, "end": 120.82, "text": " En la parte superior se aprecia el drag\u00f3n derrotado y cubierto de sangre que emana de", "tokens": [50792, 2193, 635, 6975, 13028, 369, 1882, 265, 2755, 806, 5286, 1801, 1163, 10536, 1573, 288, 10057, 20747, 368, 45878, 631, 846, 2095, 368, 51014], "temperature": 0.0, "avg_logprob": -0.11767493786455012, "compression_ratio": 1.7374100719424461, "no_speech_prob": 0.005187803879380226}, {"id": 26, "seek": 10782, "start": 120.82, "end": 126.61999
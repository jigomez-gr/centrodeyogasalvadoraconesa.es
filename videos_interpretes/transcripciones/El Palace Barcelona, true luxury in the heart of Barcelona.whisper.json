: 39, "seek": 28160, "start": 285.6, "end": 287.6, "text": " un bote, un gran bote,", "tokens": [50564, 517, 272, 1370, 11, 517, 9370, 272, 1370, 11, 50664], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 40, "seek": 28160, "start": 287.6, "end": 288.6, "text": " que le llev\u00f3 a su suelo.", "tokens": [50664, 631, 476, 27124, 812, 257, 459, 459, 10590, 13, 50714], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 41, "seek": 28160, "start": 288.6, "end": 290.6, "text": " Y \u00e9l vivi\u00f3 en el hotel por unos d\u00edas,", "tokens": [50714, 398, 11810, 11005, 7138, 465, 806, 7622, 1515, 17780, 19527, 11, 50814], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 42, "seek": 28160, "start": 290.6, "end": 293.6, "text": " por eso decidimos llamar a uno de nuestros suelos", "tokens": [50814, 1515, 7287, 21937, 8372, 16848, 289, 257, 8526, 368, 24099, 459, 338, 329, 50964], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 43, "seek": 28160, "start": 293.6, "end": 294.6, "text": " despu\u00e9s de \u00e9l.", "tokens": [50964, 15283, 368, 11810, 13, 51014], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 44, "seek": 28160, "start": 294.6, "end": 296.6, "text": " Lo mismo con Josephine Baker.", "tokens": [51014, 6130, 12461, 416, 11170, 533, 25780, 13, 51114], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 45, "seek": 28160, "start": 296.6, "end": 297.6, "text": " Siempre viv\u00eda con nosotros", "tokens": [51114, 3559, 6516, 11005, 2686, 416, 13863, 51164], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 46, "seek": 28160, "start": 297.6, "end": 300.6, "text": " y se produjo en uno de nuestros suelos", "tokens": [51164, 288, 369, 1082, 5134, 465, 8526, 368, 24099, 459, 338, 329, 51314], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 47, "seek": 28160, "start": 300.6, "end": 301.6, "text": " en el hotel.", "tokens": [51314, 465, 806, 7622, 13, 51364], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 48, "seek": 28160, "start": 301.6, "end": 303.6, "text": " Por eso tambi\u00e9n llamamos a uno de los suelos", "tokens": [51364, 5269, 7287, 6407, 16848, 2151, 257, 8526, 368, 1750, 459, 338, 329, 51464], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 49, "seek": 28160, "start": 303.6, "end": 304.6, "text": " despu\u00e9s de \u00e9l.", "tokens": [51464, 15283, 368, 11810, 13, 51514], "temperature": 0.0, "avg_logprob": -0.5610869912540212, "compression_ratio": 1.705128205128205, "no_speech_prob": 0.41619059443473816}, {"id": 50, "seek": 30460, "start": 305.6, "end": 307.6, "text": " Yo estaba muy contento de que te descubieras", "tokens": [50414, 7616, 17544, 5323, 2701, 78, 368, 631, 535, 32592, 811, 296, 50514], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 51, "seek": 30460, "start": 307.6, "end": 309.6, "text": " este hotel hist\u00f3rico unido.", "tokens": [50514, 4065, 7622, 33196, 23776, 517, 2925, 13, 50614], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 52, "seek": 30460, "start": 309.6, "end": 311.6, "text": " Hay pocas cosas que me gustan mucho aqu\u00ed.", "tokens": [50614, 8721, 714, 16369, 12218, 631, 385, 9679, 282, 9824, 6661, 13, 50714], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 53, "seek": 30460, "start": 311.6, "end": 314.6, "text": " Lo primero es la diversidad de atm\u00f3sfeles", "tokens": [50714, 6130, 21289, 785, 635, 6111, 4580, 368, 22582, 12994, 69, 6972, 50864], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 54, "seek": 30460, "start": 314.6, "end": 317.6, "text": " entre el gran decoro de todo aqu\u00ed", "tokens": [50864, 3962, 806, 9370, 7919, 78, 368, 5149, 6661, 51014], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 55, "seek": 30460, "start": 317.6, "end": 319.6, "text": " y la atm\u00f3sfera vibrante de El Yard\u00edn", "tokens": [51014, 288, 635, 22582, 12994, 45635, 11599, 2879, 368, 2699, 398, 515, 10973, 51114], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 56, "seek": 30460, "start": 319.6, "end": 320.6, "text": " en el r\u00fafaro.", "tokens": [51114, 465, 806, 367, 2481, 69, 9708, 13, 51164], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 57, "seek": 30460, "start": 320.6, "end": 322.6, "text": " El r\u00fafaro es mi segundo favorito.", "tokens": [51164, 2699, 367, 2481, 69, 9708, 785, 2752, 17954, 2294, 3528, 13, 51264], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 58, "seek": 30460, "start": 322.6, "end": 324.6, "text": " Es absolutamente orgulloso.", "tokens": [51264, 2313, 49285, 14045, 858, 9869, 13, 51364], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 59, "seek": 30460, "start": 324.6, "end": 326.6, "text": " Es como un jard\u00edn en el cielo.", "tokens": [51364, 2313, 2617, 517, 46153, 10973, 465, 806, 49549, 13, 51464], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 60, "seek": 30460, "start": 326.6, "end": 327.6, "text": " Hay puestos,", "tokens": [51464, 8721, 2362, 377, 329, 11, 51514], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 61, "seek": 30460, "start": 327.6, "end": 328.6, "text": " hay este restaurante liban\u00e9s.", "tokens": [51514, 4842, 4065, 4793, 2879, 375, 5144, 2191, 13, 51564], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 62, "seek": 30460, "start": 328.6, "end": 330.6, "text": " Tiene que ser probado, por supuesto,", "tokens": [51564, 314, 10174, 631, 816, 1239, 1573, 11, 1515, 34177, 11, 51664], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 63, "seek": 30460, "start": 330.6, "end": 331.6, "text": " cuando est\u00e9s aqu\u00ed.", "tokens": [51664, 7767, 871, 2191, 6661, 13, 51714], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 64, "seek": 30460, "start": 331.6, "end": 333.6, "text": " Y mi primer favorito es", "tokens": [51714, 398, 2752, 12595, 2294, 3528, 785, 51814], "temperature": 0.0, "avg_logprob": -0.5251207651582154, "compression_ratio": 1.6631205673758864, "no_speech_prob": 0.2894754409790039}, {"id": 65, "seek": 33360, "start": 333.6, "end": 334.6, "text": " el de Maya Juel.", "tokens": [50364, 806, 368, 21695, 508, 3483, 13, 50414], "temperature": 0.0, "avg_logprob": -0.562493606849953, "compression_ratio": 0.9090909090909091, "no_speech_prob": 0.07062233239412308}, {"id": 66, "seek": 33360, "start": 334.6, "end": 336.6, "text": " Es un coctel fant\u00e1stico", "tokens": [50414, 2313, 517, 598, 349, 338, 4115, 44855, 50514], "temperature": 0.0, "avg_logprob": -0.562493606849953, "compression_ratio": 0.9090909090909091, "no_speech_prob": 0.07062233239412308}, {"id": 67, "seek": 33360, "start": 336.6, "end": 338.6, "text": " y realmente me gust\u00f3 mucho.", "tokens": [50514, 288, 14446, 385, 9679, 812, 9824, 13, 50614], "temperature": 0.0, "avg_logprob": -0.562493606849953, "compression_ratio": 0.9090909090909091, "no_speech_prob": 0.07062233239412308}], "language": "Spanish"}